# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer "publishable" key (sb_publishable_...). Safe for the browser:
# every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Bypasses RLS. Used only by the seed script and isolation tests — never
# imported by app code that runs in the browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ─── Site ────────────────────────────────────────────────────────────────────
# Public base URL, used to build email links (confirm signup, reset password).
# Must also be listed in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── OpenAI (server only, used from Phase 5) ────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
